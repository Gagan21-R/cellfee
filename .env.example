# Copy this file to .env and paste your keys. Never commit .env.
# QpiAI QCloud (circuits): register at https://qcloud.qpiai.tech
QPIAI_QCLOUD_API_KEY=
# QpiAI Opt (QUBO/MILP solver): register at https://opt.qpiai.tech
QPIAI_OPT_API_KEY=
7d64fb4f9e3432cb6bb241a23adb874f02f931ee622f4f06b33b81b99ce12fb3
# Where shot-based quantum-kernel circuits run. Key-free default: QpiAI-QSV-Local.
# With a QCloud key: QpiAI-QSV-Simulator | QpiAI-QDM-Simulator (noisy) | QpiAI-QSV-Lite | QpiAI-Indus-1 (real QPU)
CELLFEE_KERNEL_DEVICE=QpiAI-QSV-Local
CELLFEE_KERNEL_SHOTS=2000
# Number of battery pairs sent as fidelity-test circuits (credit guard)
CELLFEE_KERNEL_EVIDENCE_PAIRS=60
# Device for QAOA sampling when a QCloud key is set
CELLFEE_QAOA_DEVICE=QpiAI-QSV-Local
# QCloud experiment for cloud jobs: create an experiment with this exact name in the QCloud web UI first
CELLFEE_QCLOUD_EXPERIMENT=cellfee
